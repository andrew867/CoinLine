# Copy to sip.env (gitignored) and fill in. Compose loads sip.env into the API.
# Do not commit sip.env.

SipModem__Enabled=true
# Default local lab; only opt in to remote ingress on a protected network.
# Set COINLINE_SIP_BIND_ADDRESS in the Compose environment for explicit host publication.
SipModem__PublicAddress=127.0.0.1
SipModem__LoopbackHost=host.docker.internal
SipModem__NccHost=127.0.0.1
SipModem__NccPort=4000
SipModem__Registrar=
SipModem__Username=
SipModem__Password=
SipModem__AssignedNumber=
